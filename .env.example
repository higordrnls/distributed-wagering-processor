# Application
PORT=3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5433
DB_USER=wager
DB_PASSWORD=wager
DB_NAME=wager

# AWS SQS / MiniStack
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_ENDPOINT=http://localhost:4566

SQS_INPUT_QUEUE_URL=http://localhost:4566/000000000000/wager-transactions.fifo
SQS_EVENTS_QUEUE_URL=http://localhost:4566/000000000000/wager-events.fifo

# Background workers
OUTBOX_POLL_INTERVAL_MS=5000
